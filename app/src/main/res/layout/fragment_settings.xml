<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Dark mode"
                android:textSize="16sp"/>
            <Switch
                android:id="@+id/swDark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Prayer notifications"
                android:textSize="16sp"/>
            <Switch
                android:id="@+id/swNotif"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Prayer alert sound"
                android:textSize="16sp"/>

            <TextView
                android:id="@+id/tvSoundValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Azan Holy Makkah"
                android:textColor="?attr/colorPrimary"
                android:textStyle="bold"
                android:padding="8dp"/>
        </LinearLayout>
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#22000000"
            android:layout_marginVertical="4dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Auto method by GPS"
                android:textSize="16sp"/>
            <Switch
                android:id="@+id/swAuto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Calculation method"
                android:textSize="16sp"/>
            <TextView
                android:id="@+id/tvMethodValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MWL"
                android:textColor="?attr/colorPrimary"
                android:textStyle="bold"
                android:padding="8dp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Madhab (Asr)"
                android:textSize="16sp"/>
            <TextView
                android:id="@+id/tvMadhab"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Shafi"
                android:textColor="?attr/colorPrimary"
                android:textStyle="bold"
                android:padding="8dp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="High-latitude rule"
                android:textSize="16sp"/>
            <TextView
                android:id="@+id/tvHighLat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="None"
                android:textColor="?attr/colorPrimary"
                android:textStyle="bold"
                android:padding="8dp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Prayer alert sound"
                android:textSize="16sp"/>

            <TextView
                android:id="@+id/tvSoundValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Azan Holy Makkah"
                android:textColor="?attr/colorPrimary"
                android:textStyle="bold"
                android:padding="8dp"/>
        </LinearLayout>
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#22000000"
            android:layout_marginVertical="4dp"/>

        <TextView
            android:id="@+id/tvExactAlarm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:text="Allow exact alarms (Android 12+)"
            android:textSize="15sp"
            android:gravity="center"
            android:textColor="?attr/colorPrimary"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvTestNotif"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:text="Test notification now"
            android:textSize="15sp"
            android:gravity="center"
            android:textColor="?attr/colorPrimary"
            android:textStyle="bold"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Prayer alert sound"
                android:textSize="16sp"/>

            <TextView
                android:id="@+id/tvSoundValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Azan Holy Makkah"
                android:textColor="?attr/colorPrimary"
                android:textStyle="bold"
                android:padding="8dp"/>
        </LinearLayout>
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#22000000"
            android:layout_marginVertical="4dp"/>

        <TextView
            android:id="@+id/tvVersion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:text="Noor Islamic Companion v1.4.0"
            android:textSize="14sp"
            android:gravity="center"
            android:textColor="#666666"/>

        <TextView
            android:id="@+id/tvReset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:text="Reset all settings"
            android:textSize="14sp"
            android:gravity="center"
            android:textColor="#C62828"/>
    </LinearLayout>
</ScrollView>
