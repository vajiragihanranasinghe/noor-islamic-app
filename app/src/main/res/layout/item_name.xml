<?xml version="1.0" encoding="utf-8"?>

<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="4dp"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/tvNumber"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_surah_number"
            android:gravity="center"
            android:text="1"
            android:textColor="@color/primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTransliteration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ar-Rahman"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvMeaning"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="The Most Merciful"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvArabic"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="الرَّحْمَٰن"
            android:textColor="@color/primary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvNameFavorite"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="6dp"
            android:layout_marginStart="4dp"
            android:text="☆"
            android:textColor="@color/primary"
            android:textSize="27sp"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Add to favorites" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
